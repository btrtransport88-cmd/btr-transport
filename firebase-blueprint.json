{
  "entities": {
    "booking": {
      "title": "Booking",
      "description": "Passenger shuttle booking and seat reservation",
      "type": "object",
      "properties": {
        "bookingReference": { "type": "string", "maxLength": 32 },
        "tripId": { "type": "string", "maxLength": 64 },
        "passengerName": { "type": "string", "maxLength": 100 },
        "passengerEmail": { "type": "string", "maxLength": 120 },
        "passengerPhone": { "type": "string", "maxLength": 20 },
        "seatCount": { "type": "number" },
        "totalFare": { "type": "number" },
        "status": { "type": "string", "enum": ["confirmed", "pending", "cancelled", "boarded", "completed"] },
        "createdAt": { "type": "string" }
      },
      "required": ["bookingReference", "tripId", "passengerName", "totalFare", "status"]
    },
    "trip": {
      "title": "Trip",
      "description": "Scheduled shuttle van journey between Buliluyan and Puerto Princesa",
      "type": "object",
      "properties": {
        "tripCode": { "type": "string", "maxLength": 32 },
        "direction": { "type": "string", "enum": ["buliluyan_to_puerto", "puerto_to_buliluyan"] },
        "travelDate": { "type": "string", "maxLength": 16 },
        "departureTime": { "type": "string", "maxLength": 8 },
        "status": { "type": "string", "enum": ["scheduled", "boarding", "departed", "arrived", "cancelled"] },
        "baseFare": { "type": "number" },
        "availableSeats": { "type": "number" }
      },
      "required": ["tripCode", "direction", "travelDate", "departureTime", "status", "baseFare"]
    },
    "operationalTask": {
      "title": "Operational Task",
      "description": "Dispatch or driver operational checklist synced with Google Tasks",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "notes": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["needsAction", "completed"] },
        "category": { "type": "string", "enum": ["inspection", "dispatch", "balabac_ferry", "maintenance", "general"] },
        "assignedRole": { "type": "string", "enum": ["admin", "driver", "all"] },
        "googleTaskId": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "status", "category"]
    },
    "driveBackup": {
      "title": "Drive Backup Record",
      "description": "Record of passenger manifests and trip data archived to Google Drive",
      "type": "object",
      "properties": {
        "fileId": { "type": "string", "maxLength": 128 },
        "fileName": { "type": "string", "maxLength": 255 },
        "mimeType": { "type": "string", "maxLength": 64 },
        "fileSize": { "type": "number" },
        "exportedBy": { "type": "string", "maxLength": 120 },
        "tripCode": { "type": "string", "maxLength": 32 },
        "webViewLink": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string" }
      },
      "required": ["fileId", "fileName", "exportedBy"]
    },
    "user": {
      "title": "User Account Profile",
      "description": "User profile with role mapping and contact details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 30 },
        "role": { "type": "string", "enum": ["passenger", "driver", "admin"] },
        "status": { "type": "string", "enum": ["active", "inactive", "suspended", "pending_verification", "rejected"] },
        "driverId": { "type": "string", "maxLength": 64 },
        "licenseNumber": { "type": "string", "maxLength": 40 },
        "assignedVehicleId": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["name", "email", "role", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "User accounts with role-based attributes and contact info"
    },
    "/bookings/{bookingId}": {
      "schema": "booking",
      "description": "Passenger booking reservations and ticket data"
    },
    "/trips/{tripId}": {
      "schema": "trip",
      "description": "Daily shuttle departure schedules"
    },
    "/operationalTasks/{taskId}": {
      "schema": "operationalTask",
      "description": "Dispatch and driver operational checklist tasks synced with Google Tasks"
    },
    "/driveBackups/{backupId}": {
      "schema": "driveBackup",
      "description": "Metadata for manifests and data exported to Google Drive"
    }
  }
}
